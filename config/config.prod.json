{
  "environment": "prod",
  "defaults": {
    "botConcurrency": 1,
    "networkRps": 1,
    "networkCooldownMs": 10000,
    "networkCooldownThreshold": 3,
    "networkCooldownWindowMs": 30000,
    "networkJitterRatio": 0.2,
    "requestDelayMs": 1200,
    "requestJitterMs": 900,
    "maxConsecutiveDownloadFailures": 3,
    "downloadMode": "bulk",
    "unzip": true,
    "logFormat": "pretty",
    "logLevel": "info"
  },
  "botGroups": [
    {
      "bot": "civil",
      "maxPages": 10,
      "searchTerms": [
        "herencia",
        "derecho a vivienda"
      ]
    },
    {
      "bot": "familia",
      "maxPages": 10,
      "searchTerms": [
        "familia"
      ]
    }
  ]
}
